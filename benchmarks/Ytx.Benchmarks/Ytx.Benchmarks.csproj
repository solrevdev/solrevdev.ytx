<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Standalone benchmark and verification harness for ytx's caption formatting and JSON output.
    It is not referenced by src/Ytx or tests/Ytx.Tests, and CI builds those projects by path,
    so this project never takes part in `dotnet test` or `dotnet pack` for the tool.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Same pattern as src/Ytx: net11.0 only when the SDK is 11 or later. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ytx.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Match what a CLI process gets by default; server GC would distort allocation costs. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Only the `capture` command uses this. Keep it on the same version as src/Ytx. -->
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
  </ItemGroup>
</Project>
